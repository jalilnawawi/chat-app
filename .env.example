# Backend
DATABASE_URL=postgres://chat:chat@localhost:5433/chatapp?sslmode=disable
HTTP_ADDR=:8090
# Origin frontend yang diizinkan (CORS + pemeriksaan origin WebSocket).
# Pisahkan dengan koma. "localhost" dan "127.0.0.1" adalah origin berbeda di
# mata browser walau menunjuk mesin yang sama, jadi keduanya perlu disebut.
ALLOWED_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
# Set true kalau sudah di belakang HTTPS
SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Multi-instance (Fase 6)
# ---------------------------------------------------------------------------
# Kosongkan untuk mode satu instance: hub dan rate limit memakai memori proses,
# dan `go run ./cmd/server` cukup untuk menjalankan seluruh aplikasi.
# Diisi = siaran lewat Redis pub/sub dan presence lewat key ber-TTL, sehingga
# beberapa instance bisa melayani user yang sama.
# REDIS_URL=redis://localhost:6380/0

# Pembeda proses di log, metrik, dan klaim presence. Default: hostname + acak.
# INSTANCE_ID=

# Umur klaim presence sebuah instance di Redis. Menentukan seberapa cepat user
# yang instance-nya mati mendadak berubah jadi offline.
PRESENCE_TTL=45s

# Batas koneksi pool Postgres. 0 = bawaan pgx (4 atau jumlah core, mana yang
# lebih besar). Naikkan bila chat_db_pool_acquire_wait_seconds_total ikut naik.
DB_MAX_CONNS=0

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# /metrics dilayani di listener terpisah dari API publik. Kosongkan port ini
# dari internet: isinya membocorkan bentuk internal sistem.
METRICS_ADDR=:9091

# ---------------------------------------------------------------------------
# Shutdown bertahap (rolling deploy)
# ---------------------------------------------------------------------------
# Jeda antara /readyz mulai menjawab 503 dan koneksi mulai ditutup. Beri load
# balancer waktu berhenti mengirim trafik baru.
DRAIN_DELAY=5s
# Rentang penyebaran penutupan WebSocket. Menutup 1000 koneksi serentak berarti
# 1000 reconnect serentak ke instance pengganti yang belum panas.
DRAIN_PERIOD=20s
# Batas keras seluruh proses shutdown. Harus > DRAIN_DELAY + DRAIN_PERIOD.
SHUTDOWN_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Kuota per user (token bucket: _BURST sekali ledak, _PER_MIN laju berkelanjutan)
# ---------------------------------------------------------------------------
RATE_MESSAGES_BURST=20
RATE_MESSAGES_PER_MIN=120
RATE_CONNECTS_BURST=10
RATE_CONNECTS_PER_MIN=60
RATE_TYPING_BURST=20
RATE_TYPING_PER_MIN=120
# Login/register diverifikasi dengan argon2id yang sengaja mahal — kuotanya
# per alamat IP, dan jauh lebih ketat.
RATE_AUTH_BURST=10
RATE_AUTH_PER_MIN=30
