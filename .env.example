# Backend
DATABASE_URL=postgres://chat:chat@localhost:5433/chatapp?sslmode=disable
HTTP_ADDR=:8090
# Origin frontend yang diizinkan (CORS + pemeriksaan origin WebSocket).
# Pisahkan dengan koma. "localhost" dan "127.0.0.1" adalah origin berbeda di
# mata browser walau menunjuk mesin yang sama, jadi keduanya perlu disebut.
ALLOWED_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
# Set true kalau sudah di belakang HTTPS
SECURE_COOKIE=false
