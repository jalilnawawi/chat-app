# Backend
DATABASE_URL=postgres://chat:chat@localhost:5433/chatapp?sslmode=disable
HTTP_ADDR=:8090
# Origin frontend yang diizinkan (CORS + pemeriksaan origin WebSocket).
# Pisahkan dengan koma. "localhost" dan "127.0.0.1" adalah origin berbeda di
# mata browser walau menunjuk mesin yang sama, jadi keduanya perlu disebut.
ALLOWED_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
# Set true kalau sudah di belakang HTTPS
SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Multi-instance (Fase 6)
# ---------------------------------------------------------------------------
# Kosongkan untuk mode satu instance: hub dan rate limit memakai memori proses,
# dan `go run ./cmd/server` cukup untuk menjalankan seluruh aplikasi.
# Diisi = siaran lewat Redis pub/sub dan presence lewat key ber-TTL, sehingga
# beberapa instance bisa melayani user yang sama.
# REDIS_URL=redis://localhost:6380/0

# Pembeda proses di log, metrik, dan klaim presence. Default: hostname + acak.
# INSTANCE_ID=

# Umur klaim presence sebuah instance di Redis. Menentukan seberapa cepat user
# yang instance-nya mati mendadak berubah jadi offline.
PRESENCE_TTL=45s

# Batas koneksi pool Postgres. 0 = bawaan pgx (4 atau jumlah core, mana yang
# lebih besar). Naikkan bila chat_db_pool_acquire_wait_seconds_total ikut naik.
DB_MAX_CONNS=0

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# /metrics dilayani di listener terpisah dari API publik. Kosongkan port ini
# dari internet: isinya membocorkan bentuk internal sistem.
METRICS_ADDR=:9091

# ---------------------------------------------------------------------------
# Shutdown bertahap (rolling deploy)
# ---------------------------------------------------------------------------
# Jeda antara /readyz mulai menjawab 503 dan koneksi mulai ditutup. Beri load
# balancer waktu berhenti mengirim trafik baru.
DRAIN_DELAY=5s
# Rentang penyebaran penutupan WebSocket. Menutup 1000 koneksi serentak berarti
# 1000 reconnect serentak ke instance pengganti yang belum panas.
DRAIN_PERIOD=20s
# Batas keras seluruh proses shutdown. Harus > DRAIN_DELAY + DRAIN_PERIOD.
SHUTDOWN_TIMEOUT=60s

# ---------------------------------------------------------------------------
# Lampiran (Fase 7)
# ---------------------------------------------------------------------------
# Kosongkan untuk mematikan unggahan: aplikasi tetap jalan penuh sebagai chat
# teks, dan tombol lampiran hilang sendiri dari UI.
SEAWEED_FILER_URL=http://127.0.0.1:8890
# Awalan path di dalam filer. Berguna kalau satu klaster SeaweedFS dipakai
# beberapa aplikasi.
SEAWEED_PREFIX=/chat/attachments

# Batas keras satu berkas, dalam byte. Client memeriksa lebih dulu, tapi hanya
# supaya orang tidak menunggu unggahan yang sudah pasti ditolak — yang mengikat
# adalah angka di sini. Bawaan: 10 MB.
MAX_UPLOAD_BYTES=10485760

# Umur lampiran yang sudah diunggah tapi tidak pernah jadi dikirim, sebelum
# disapu. Ini terjadi tiap kali orang memilih foto lalu berubah pikiran.
ATTACHMENT_ORPHAN_TTL=6h

# ---------------------------------------------------------------------------
# Turunan gambar (Fase 8)
# ---------------------------------------------------------------------------
# Panjang sisi terpanjang turunan, dalam piksel. Nol mematikan pembuatan
# turunan sama sekali: aplikasi kembali menyajikan berkas asli untuk semua
# gambar, dan tidak ada satu pun jalur yang setengah hidup.
#
# Bawaan 480 cukup untuk layar rapat pada gelembung pesan selebar 300 piksel,
# dan masih sekitar seperseratus ukuran foto dari ponsel.
THUMBNAIL_MAX_DIM=480

# Batas jumlah piksel yang boleh didekode. Satuannya PIKSEL, bukan byte — dan
# itu bukan kerewelan: berkas PNG seratus kilobyte bisa berisi kanvas
# 40.000 x 40.000, sah menurut standar dan enam gigabyte begitu dibentangkan di
# memori. MAX_UPLOAD_BYTES tidak menolongnya sama sekali, karena yang meledak
# bukan berkasnya melainkan hasil dekodenya.
#
# Bawaan 50 juta kira-kira dua kali kamera ponsel kelas atas.
THUMBNAIL_MAX_PIXELS=50000000

# Berapa gambar boleh didekode BERSAMAAN. Satu foto dua belas megapiksel jadi
# sekitar lima puluh megabyte piksel mentah saat dibentangkan, dan angka itu
# tidak ada hubungannya dengan ukuran berkasnya.
#
# Sengaja kecil dan tidak mengikuti jumlah inti mesin: yang dibatasi di sini
# memori, bukan CPU. Unggahan yang tidak kebagian giliran dalam tiga detik
# tetap berhasil — hanya tanpa turunan.
THUMBNAIL_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Push notification (Fase 7)
# ---------------------------------------------------------------------------
# Buat sepasang kunci SEKALI dengan `cd server && go run ./cmd/vapid`, lalu
# simpan. JANGAN membuat ulang: browser mengunci langganannya pada kunci publik
# yang dipakai saat mendaftar, sehingga kunci baru membuat seluruh langganan
# yang ada berhenti bekerja diam-diam — tanpa error, notifikasinya saja tidak
# pernah sampai lagi.
#
# Dikosongkan = notifikasi mati, dan tombolnya hilang dari UI.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Kontak yang bisa dihubungi operator layanan push (Google, Mozilla, Apple)
# kalau server ini bermasalah. Wajib mailto: atau https://.
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Kuota per user (token bucket: _BURST sekali ledak, _PER_MIN laju berkelanjutan)
# ---------------------------------------------------------------------------
RATE_MESSAGES_BURST=20
RATE_MESSAGES_PER_MIN=120
RATE_CONNECTS_BURST=10
RATE_CONNECTS_PER_MIN=60
RATE_TYPING_BURST=20
RATE_TYPING_PER_MIN=120
# Login/register diverifikasi dengan argon2id yang sengaja mahal — kuotanya
# per alamat IP, dan jauh lebih ketat.
RATE_AUTH_BURST=10
RATE_AUTH_PER_MIN=30
# Unggahan jauh lebih mahal dari pesan teks: satu berkas bisa sepuluh megabyte
# yang melewati proses ini dua kali, masuk dan keluar.
RATE_UPLOADS_BURST=10
RATE_UPLOADS_PER_MIN=60

# Reaksi jauh lebih longgar dari pesan: menekan lima emoji beruntun pada satu
# pesan lucu adalah perilaku manusia yang wajar, dan tiap penekanan jauh lebih
# murah daripada satu pesan. Yang dibatasi di sini adalah jari yang menekan dan
# melepas tombol yang sama berulang-ulang — dua permintaan tiap kali.
RATE_REACTIONS_BURST=30
RATE_REACTIONS_PER_MIN=240

# @semua dihitung per user PER PERCAKAPAN, dan angkanya sengaja kecil: satu
# orang yang membangunkan dua ratus orang sekaligus adalah hal yang harus
# dibatasi, bukan dilarang. Dua beruntun, lalu satu tiap dua menit — diambil
# dari cara rapat sungguhan diumumkan, bukan dari kemampuan server mengirim.
RATE_MENTION_ALL_BURST=2
RATE_MENTION_ALL_PER_MIN=0.5

# RATE_PUSH bukan kuota melawan penyalahgunaan, melainkan peredam dering:
# berapa kali satu percakapan boleh membangunkan satu orang. Dua di awal supaya
# kabar pertama tidak pernah tertelan, lalu dua per menit — kira-kira satu
# dering tiap 30 detik per percakapan.
RATE_PUSH_BURST=2
RATE_PUSH_PER_MIN=2
